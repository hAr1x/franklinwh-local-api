# FranklinWH aGate connection settings for local Modbus TCP access.
# Copy this file to ".env" and fill in your aGate's IP address.

# Required: the LAN IP address of your aGate gateway.
AGATE_IP=192.168.1.50

# Optional: Modbus TCP port (default 502).
AGATE_PORT=502

# Optional: Modbus unit/slave ID. The aGate has been observed to
# ignore/alias this field and respond identically regardless of value,
# so 0 is used as a safe default.
AGATE_UNIT_ID=0

# Optional: Modbus operation timeout in seconds.
AGATE_TIMEOUT=10.0
